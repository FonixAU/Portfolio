---
// One entry, in two parts: .summary is the small card, .full is the rest.
// Jobs and projects share this file but use different headings and sections.
import { render } from 'astro:content';
import sharp from 'sharp';
import type { Body } from '../lib/bodies';
import type { Skill } from '../lib/skills';
interface Props { b: Body; kids: Body[]; skills: Skill[] }
const { b, kids, skills } = Astro.props;
const groups = Object.entries(Object.groupBy(skills, (s) => s.group)); // the sun lists every skill
const { Content } = await render(b.entry);
const job = b.kind === 'employer' || b.kind === 'role';
const status = { live: 'Live', 'in-progress': 'In progress', archived: 'Archived', incomplete: 'Not complete' }[b.status ?? ''];
// Picture sizes, so portrait shots can be given more height.
const shots = await Promise.all(b.images.map(async (im) => { const m = await sharp(`public/${im.src.replace(/^\//, '')}`).metadata(); return { ...im, w: m.width!, h: m.height! }; }));
const hasText = Boolean(b.entry.body?.trim());
const up = b.parent ? { url: b.url.replace(/[^/]+\/$/, ''), id: b.parent } : null; // moons get a Back button to their planet
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// The contact form posts to EmailJS, using the same service and template as the old site. Set the three PUBLIC_EMAILJS_* variables at build time to switch it on.
const env = (k: string) => import.meta.env[`PUBLIC_EMAILJS_${k}`] ?? process.env[`PUBLIC_EMAILJS_${k}`] ?? process.env[`NEXT_PUBLIC_EMAILJS_${k}`] ?? process.env[`EMAILJS_${k}`];
const mail = { service: env('SERVICE'), template: env('TEMPLATE'), key: env('PK') };
if (b.kind === 'sun' && !(globalThis as any).__mailLogged && ((globalThis as any).__mailLogged = true)) console.log(`[contact form] ${mail.service && mail.template && mail.key ? 'enabled' : 'disabled: missing ' + ['SERVICE', 'TEMPLATE', 'PK'].filter((k) => !env(k)).join(', ')}; EmailJS variables present: ${Object.keys(process.env).filter((k) => k.includes('EMAILJS')).join(', ') || 'none'}`);
const mailOn = b.kind === 'sun' && mail.service && mail.template && mail.key;
// Icons for known link labels (Simple Icons paths); anything else stays a text button.
const icons: Record<string, string> = {
  GitHub: 'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
  LinkedIn: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 4.892v6.293zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
};
const sun = b.kind === 'sun';
---
<button class="btn close icon" type="button" data-close aria-label="Close" title="Close"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13" /></svg></button>
<div class="summary">
  <h2>{b.title}{status && <span class={`badge ${b.status}`}>{status}</span>}</h2>
  <div class="info">
    {b.what && <p class="what">{b.what}</p>}
    {(b.when || b.part) && <p class="meta">{[b.when, b.part].filter(Boolean).join(' · ')}</p>}
    {sun && b.links.length > 0 && <p class="links">{b.links.map((l) => <a class="btn handle" href={l.url}>{icons[l.label] && <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons[l.label]} /></svg>}<span class="sr">{l.label}: </span>{l.url.replace(/\/+$/, '').split('/').pop()}</a>)}</p>}
    {b.stack.length > 0 && <ul class="tags">{b.stack.map((s) => <li>{s}</li>)}</ul>}
  </div>
  <button class="btn open" type="button" data-open>{b.kind === 'sun' ? 'Get in touch' : 'Open entry'}</button>
</div>
<div class="full">
  {up && <a class="btn back icon" href={up.url} data-id={up.id} aria-label="Back" title="Back"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3L5 8l5 5" /></svg></a>}
  {kids.length > 0 && (
    <section class="sub"><h3>{job ? 'Roles' : 'Parts'}</h3>
      <ul class="kids">{kids.map((k) => <li><a href={k.url} data-id={k.id}>{k.title}</a>{k.when && <span> · {k.when}</span>}</li>)}</ul>
    </section>
  )}
  <div class="desc">
  {hasText && <section><div class="prose"><Content /></div></section>}
  {b.achievements.length > 0 && <section><h3>Achievements</h3><ul>{b.achievements.map((a) => <li>{a}</li>)}</ul></section>}
  {b.outcome && <section><h3>Outcome</h3><p>{b.outcome}</p></section>}
  {b.highlights.length > 0 && <section><h3>Highlights</h3><ul>{b.highlights.map((a) => <li>{a}</li>)}</ul></section>}
  {mailOn && (
    <section class="contact"><h3>Send a message</h3>
      <form data-mail data-service={mail.service} data-template={mail.template} data-key={mail.key}>
        <label>Name<input name="name" autocomplete="name" required /></label>
        <label>Email<input name="email" type="email" autocomplete="email" required /></label>
        <label>Subject<input name="subject" required /></label>
        <label>Message<textarea name="message" rows="5" required></textarea></label>
        <label class="hp" aria-hidden="true">Leave this empty<input name="website" tabindex="-1" autocomplete="off" /></label>
        <button class="btn" type="submit">Send message</button>
        <p role="status" data-status></p>
      </form>
    </section>
  )}
  {groups.length > 0 && (
    <section class="skills"><h3>Skills</h3>
      {groups.map(([g, list]) => (<><h4>{g}</h4><ul class="tags">{list!.map((s) => (
        <li class:list={[!s.used.length && 'quiet']}>{s.used.length ? <a href={`${base}?skill=${encodeURIComponent(s.name)}`} data-skill={s.name} title={`Used in: ${s.used.map((u) => u.title).join(', ')}. Show on the map`}>{s.name}</a> : s.name}</li>))}</ul></>))}
    </section>
  )}
  </div>
  {!sun && b.links.length > 0 && <p class="links">{b.links.map((l) => <a class="btn" href={l.url}>{l.label}</a>)}</p>}
  {b.images.length > 0 && (
    <figure class="shots">{shots.map((im) => <img class:list={[im.h > im.w && 'tall']} src={base + im.src.replace(/^\//, '')} alt={im.alt} width={im.w} height={im.h} loading="lazy" />)}</figure>
  )}
</div>
