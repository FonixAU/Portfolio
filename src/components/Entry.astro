---
// One entry, in two parts: .summary is the small card, .full is the rest.
// Jobs and projects share this file but use different headings and sections.
import { render } from 'astro:content';
import type { Body } from '../lib/bodies';
interface Props { b: Body; kids: Body[] }
const { b, kids } = Astro.props;
const { Content } = await render(b.entry);
const job = b.kind === 'employer' || b.kind === 'role';
const status = { live: 'Live', 'in-progress': 'In progress', archived: 'Archived', incomplete: 'Not complete' }[b.status ?? ''];
const hasText = Boolean(b.entry.body?.trim());
---
<div class="summary">
  <h2>{b.title}{status && <span class={`badge ${b.status}`}>{status}</span>}</h2>
  {b.what && <p class="what">{b.what}</p>}
  {(b.when || b.part) && <p class="meta">{[b.when, b.part].filter(Boolean).join(' · ')}</p>}
  {b.stack.length > 0 && <ul class="tags">{b.stack.map((s) => <li>{s}</li>)}</ul>}
  <button class="btn open" type="button" data-open>Open entry</button>
</div>
<div class="full">
  <button class="btn close" type="button" data-close>Close</button>
  {b.images.length > 0 && (
    <figure class="shots">{b.images.map((im) => <img src={im.src} alt={im.alt} loading="lazy" />)}</figure>
  )}
  {kids.length > 0 && (
    <section><h3>{job ? 'Roles' : 'Parts'}</h3>
      <ul class="kids">{kids.map((k) => <li><a href={k.url} data-id={k.id}>{k.title}</a>{k.when && <span> · {k.when}</span>}</li>)}</ul>
    </section>
  )}
  {hasText && <section><h3>{b.kind === 'sun' ? 'About' : job ? 'What I did' : 'What I built'}</h3><div class="prose"><Content /></div></section>}
  {b.achievements.length > 0 && <section><h3>Achievements</h3><ul>{b.achievements.map((a) => <li>{a}</li>)}</ul></section>}
  {b.outcome && <section><h3>Outcome</h3><p>{b.outcome}</p></section>}
  {b.highlights.length > 0 && <section><h3>Highlights</h3><ul>{b.highlights.map((a) => <li>{a}</li>)}</ul></section>}
  {b.links.length > 0 && <p class="links">{b.links.map((l) => <a class="btn" href={l.url}>{l.label}</a>)}</p>}
</div>
