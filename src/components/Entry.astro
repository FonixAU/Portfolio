---
// One entry, in two parts: .summary is the small card, .full is the rest.
// Jobs and projects share this file but use different headings and sections.
import { render } from 'astro:content';
import type { Body } from '../lib/bodies';
interface Props { b: Body; kids: Body[] }
const { b, kids } = Astro.props;
const { Content } = await render(b.entry);
const job = b.kind === 'employer' || b.kind === 'role';
const status = { live: 'Live', 'in-progress': 'In progress', archived: 'Archived', incomplete: 'Not complete' }[b.status ?? ''];
const hasText = Boolean(b.entry.body?.trim());
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// The contact form posts to EmailJS, using the same service and template as the old site. Set the three PUBLIC_EMAILJS_* variables at build time to switch it on.
const env = (k: string) => import.meta.env[`PUBLIC_EMAILJS_${k}`] ?? process.env[`PUBLIC_EMAILJS_${k}`] ?? process.env[`NEXT_PUBLIC_EMAILJS_${k}`] ?? process.env[`EMAILJS_${k}`];
const mail = { service: env('SERVICE'), template: env('TEMPLATE'), key: env('PK') };
if (b.kind === 'sun' && !(globalThis as any).__mailLogged && ((globalThis as any).__mailLogged = true)) console.log(`[contact form] ${mail.service && mail.template && mail.key ? 'enabled' : 'disabled: missing ' + ['SERVICE', 'TEMPLATE', 'PK'].filter((k) => !env(k)).join(', ')}; EmailJS variables present: ${Object.keys(process.env).filter((k) => k.includes('EMAILJS')).join(', ') || 'none'}`);
const mailOn = b.kind === 'sun' && mail.service && mail.template && mail.key;
---
<div class="summary">
  <h2>{b.title}{status && <span class={`badge ${b.status}`}>{status}</span>}</h2>
  <div class="info">
    {b.what && <p class="what">{b.what}</p>}
    {(b.when || b.part) && <p class="meta">{[b.when, b.part].filter(Boolean).join(' · ')}</p>}
    {b.stack.length > 0 && <ul class="tags">{b.stack.map((s) => <li>{s}</li>)}</ul>}
  </div>
  <button class="btn open" type="button" data-open>{b.kind === 'sun' ? 'Get in touch' : 'Open entry'}</button>
</div>
<div class="full">
  <button class="btn close" type="button" data-close>Close</button>
  {b.images.length > 0 && (
    <figure class="shots">{b.images.map((im) => <img src={base + im.src.replace(/^\//, '')} alt={im.alt} loading="lazy" />)}</figure>
  )}
  {kids.length > 0 && (
    <section class="sub"><h3>{job ? 'Roles' : 'Parts'}</h3>
      <ul class="kids">{kids.map((k) => <li><a href={k.url} data-id={k.id}>{k.title}</a>{k.when && <span> · {k.when}</span>}</li>)}</ul>
    </section>
  )}
  <div class="desc">
  {hasText && <section><div class="prose"><Content /></div></section>}
  {b.achievements.length > 0 && <section><h3>Achievements</h3><ul>{b.achievements.map((a) => <li>{a}</li>)}</ul></section>}
  {b.outcome && <section><h3>Outcome</h3><p>{b.outcome}</p></section>}
  {b.highlights.length > 0 && <section><h3>Highlights</h3><ul>{b.highlights.map((a) => <li>{a}</li>)}</ul></section>}
  {mailOn && (
    <section class="contact"><h3>Send a message</h3>
      <form data-mail data-service={mail.service} data-template={mail.template} data-key={mail.key}>
        <label>Name<input name="name" autocomplete="name" required /></label>
        <label>Email<input name="email" type="email" autocomplete="email" required /></label>
        <label>Subject<input name="subject" required /></label>
        <label>Message<textarea name="message" rows="5" required></textarea></label>
        <label class="hp" aria-hidden="true">Leave this empty<input name="website" tabindex="-1" autocomplete="off" /></label>
        <button class="btn" type="submit">Send message</button>
        <p role="status" data-status></p>
      </form>
    </section>
  )}
  </div>
  {b.links.length > 0 && <p class="links">{b.links.map((l) => <a class="btn" href={l.url}>{l.label}</a>)}</p>}
</div>
